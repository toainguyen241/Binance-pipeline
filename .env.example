# Copy this file to .env, then replace every change-me value before starting.

# ClickHouse.
CLICKHOUSE_USER=binance
CLICKHOUSE_PASSWORD=change-me-clickhouse

# Airflow metadata database.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-postgres

# Airflow local admin account.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-admin
AIRFLOW_DAGS_ARE_PAUSED_AT_CREATION=false

# Paste a key made by the command below (44 characters); do not type your own.
# generate: uv run python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())" then replace the value below.
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=change-me

# Optional Telegram failure alerts.
AIRFLOW_VAR_TELEGRAM_BOT_TOKEN=
AIRFLOW_VAR_TELEGRAM_CHAT_ID=

# Producer reliability and backpressure.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_MESSAGE_TIMEOUT_MS=15000
KAFKA_QUEUE_HIGH_WATERMARK=10000
BINANCE_WS_PING_INTERVAL_SECONDS=20
BINANCE_WS_PING_TIMEOUT_SECONDS=20
BINANCE_WS_OPEN_TIMEOUT_SECONDS=10
BINANCE_WS_CLOSE_TIMEOUT_SECONDS=5
PRODUCER_HEARTBEAT_INTERVAL_SECONDS=5

# Pipeline health.
PIPELINE_ACTIVE_ENGINE=flink
PIPELINE_PROGRESS_WINDOW_SECONDS=30
PIPELINE_MAX_LAG_RECORDS=10000
PIPELINE_FRESHNESS_THRESHOLD_SECONDS=60

# Runtime retention. 
KAFKA_RETENTION_HOURS=168
KAFKA_OFFSETS_RETENTION_MINUTES=10080
CLICKHOUSE_RETENTION_DAYS=7
CHECKPOINT_RETENTION_DAYS=7
AIRFLOW_LOG_RETENTION_DAYS=7
MAINTENANCE_INTERVAL_SECONDS=86400

# Flink defaults.
FLINK_WINDOW_SIZE_SECONDS=10
FLINK_WATERMARK_DELAY_SECONDS=3
FLINK_WATERMARK_IDLENESS_SECONDS=30
FLINK_ALLOWED_LATENESS_SECONDS=10
FLINK_RAW_BUFFER_SIZE=500
FLINK_RAW_FLUSH_INTERVAL_MS=500
FLINK_OHLC_BUFFER_SIZE=8
FLINK_OHLC_FLUSH_INTERVAL_MS=5000
FLINK_LATE_TRADE_LOG_EVERY=10000
FLINK_CHECKPOINT_INTERVAL_MS=10000
FLINK_CHECKPOINT_MIN_PAUSE_MS=5000
FLINK_CHECKPOINT_TIMEOUT_MS=60000
FLINK_CHECKPOINT_STORAGE_URI=file:///opt/flink/checkpoints
FLINK_PARTITION_DISCOVERY_INTERVAL_MS=10000
FLINK_CONSUMER_GROUP_ID=flink-ohlc-consumer-by-engine-v2

# Spark defaults.
SPARK_RAW_TRIGGER_INTERVAL=5 seconds
SPARK_WINDOW_DURATION=10 seconds
SPARK_WATERMARK_DELAY=10 seconds
SPARK_WINDOWED_TRIGGER_INTERVAL=10 seconds
SPARK_WINDOWED_OUTPUT_MODE=update
SPARK_SHUFFLE_PARTITIONS=8
SPARK_MAX_OFFSETS_PER_TRIGGER=5000
SPARK_MICROBATCH_CHECKPOINT_LOCATION=/tmp/checkpoints/binance_microbatch_tuned_v2
SPARK_WINDOWED_CHECKPOINT_LOCATION=/tmp/checkpoints/binance_windowed_agg_tuned_v3
