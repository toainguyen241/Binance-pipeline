FROM apache/spark:3.5.9@sha256:af02a459c8706e031c835c16f9db3c463816776e2543dd0f828af65606bcf392

USER root
WORKDIR /opt/app

ARG SPARK_CONNECTOR_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=30
ARG SPARK_CONNECTOR_DOWNLOAD_MAX_TIME_SECONDS=300

RUN set -eu; \
    curl -fsSL --retry 3 --retry-delay 2 \
      --connect-timeout "${SPARK_CONNECTOR_DOWNLOAD_CONNECT_TIMEOUT_SECONDS}" \
      --max-time "${SPARK_CONNECTOR_DOWNLOAD_MAX_TIME_SECONDS}" \
      -o /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.5.9.jar \
      https://repo.maven.apache.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.9/spark-sql-kafka-0-10_2.12-3.5.9.jar; \
    curl -fsSL --retry 3 --retry-delay 2 \
      --connect-timeout "${SPARK_CONNECTOR_DOWNLOAD_CONNECT_TIMEOUT_SECONDS}" \
      --max-time "${SPARK_CONNECTOR_DOWNLOAD_MAX_TIME_SECONDS}" \
      -o /opt/spark/jars/spark-token-provider-kafka-0-10_2.12-3.5.9.jar \
      https://repo.maven.apache.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.9/spark-token-provider-kafka-0-10_2.12-3.5.9.jar; \
    curl -fsSL --retry 3 --retry-delay 2 \
      --connect-timeout "${SPARK_CONNECTOR_DOWNLOAD_CONNECT_TIMEOUT_SECONDS}" \
      --max-time "${SPARK_CONNECTOR_DOWNLOAD_MAX_TIME_SECONDS}" \
      -o /opt/spark/jars/kafka-clients-3.4.1.jar \
      https://repo.maven.apache.org/maven2/org/apache/kafka/kafka-clients/3.4.1/kafka-clients-3.4.1.jar; \
    curl -fsSL --retry 3 --retry-delay 2 \
      --connect-timeout "${SPARK_CONNECTOR_DOWNLOAD_CONNECT_TIMEOUT_SECONDS}" \
      --max-time "${SPARK_CONNECTOR_DOWNLOAD_MAX_TIME_SECONDS}" \
      -o /opt/spark/jars/commons-pool2-2.11.1.jar \
      https://repo.maven.apache.org/maven2/org/apache/commons/commons-pool2/2.11.1/commons-pool2-2.11.1.jar; \
    echo "fed393dcc3ef70611fe3d4f35ae78a8ea7c55301fd4cdd66c5dc97fcfaa5a00f  /opt/spark/jars/spark-sql-kafka-0-10_2.12-3.5.9.jar" | sha256sum -c -; \
    echo "e82612e6070438c5ea48b08c74f367a6d214a390bdf6dcf3ff316dca592ddda5  /opt/spark/jars/spark-token-provider-kafka-0-10_2.12-3.5.9.jar" | sha256sum -c -; \
    echo "9d0a9058c8ede79db6e54ae378ed16fe8d1bead2894635a4aa6aa0b7981668c6  /opt/spark/jars/kafka-clients-3.4.1.jar" | sha256sum -c -; \
    echo "ea0505ee7515e58b1ac0e686e4d1a5d9f7d808e251a61bc371aa0595b9963f83  /opt/spark/jars/commons-pool2-2.11.1.jar" | sha256sum -c -

RUN pip install --no-cache-dir requests==2.34.2

COPY src/consumer/spark_windowed_aggregation.py .
COPY src/consumer/clickhouse_http.py .
COPY src/consumer/spark_entrypoint.sh .

RUN chmod 0755 /opt/app/spark_entrypoint.sh

CMD ["/opt/app/spark_entrypoint.sh", "/opt/spark/bin/spark-submit", \
     "--master", "local[4]", \
     "/opt/app/spark_windowed_aggregation.py"]
